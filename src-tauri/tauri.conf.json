{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InsightForge",
  "version": "0.1.0",
  "identifier": "app.insightforge.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InsightForge",
        "width": 1200,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "本地优先的反代写写作工作台",
    "longDescription": "织知 InsightForge —— 本地优先的桌面反代写写作工作台：知识库在你自己的文件夹里，AI 只递问题与证据，血肉由你亲手补。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": "${env.INSIGHTFORGE_CERT_THUMBPRINT}",
      "timestampUrl": "https://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://localhost/updater-dev.json"],
      "pubkey": "dW50cnVzdGVkIGJ5IHNpbW9sZiBvciB0ZXN0",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
